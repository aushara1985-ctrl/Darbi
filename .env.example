# Darbi Environment Variables
# Copy this to Railway Variables

# Required
DATABASE_URL=postgresql://user:password@host:5432/darbi
JWT_SECRET=your_random_secret_here_change_this

# Optional but recommended
OPENAI_API_KEY=sk-...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=https://your-domain.railway.app
