# Darbi Environment Variables
# Copy this to Railway Variables

# Required
DATABASE_URL=postgresql://user:password@host:5432/darbi
JWT_SECRET=your_random_secret_here_change_this

# Optional but recommended
OPENAI_API_KEY=sk-...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=https://your-domain.railway.app

# Stripe prices (Ali, 2026-11-18). Stripe is the ONLY payment path.
# Optional: create the 3 Prices in Stripe and paste their IDs. If a variable is empty the server sends the amount inline.
#   Starter  $9  / month  (recurring)
#   Pro      $19 / month  (recurring)
#   Founder  $199 one-time (lifetime)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_FOUNDER_LIFETIME=price_...
